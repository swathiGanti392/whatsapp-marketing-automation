# Local settings are not loaded automatically; export them through your process manager.
# Never put real tokens or access keys in this example file.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=your_whatsapp_sender_number
TWILIO_WEBHOOK_URL=https://your-public-host.example/webhook/whatsapp

# Safe POC default for local testing. The SAM deployment also uses capture.
REPLY_TRANSPORT=capture
PORT=5001
AWS_DEFAULT_REGION=ap-southeast-2

# Optional: override packaged listing data or enable the deployed test lead APIs.
# LISTINGS_FILE=data/listings.json
# LEADS_TABLE=your_deployed_leads_table
# TEST_SITE_ORIGIN=https://your-tester.example

# Use an AWS profile/role for credentials. Do not add access keys here.
